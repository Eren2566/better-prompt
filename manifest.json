{
  "manifest_version": 3,
  "name": "Better Prompt",
  "version": "2.0.0",
  "description": "专业提示词优化工具 - 三击空格自动优化提示词",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Prompt - 提示词优化器"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "assets/*", 
        "css/*", 
        "js/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
} 